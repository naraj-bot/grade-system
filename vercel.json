{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://grade-bangpoon69.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/pdf.js": {
      "maxDuration": 60,
      "includeFiles": "public/**"
    }
  }
}